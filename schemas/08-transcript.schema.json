{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:scribe-exchange:schema:transcript",
  "$comment": "Defined in spec/08-transcripts.md \u00a78.3 (Scribe Exchange Protocol v0.1)",
  "title": "Transcript",
  "description": "The whole text of one audio source. Available once the source is success; written once.",
  "type": "object",
  "required": [
    "source_id",
    "stt_model",
    "language_detected",
    "duration_ms",
    "text",
    "created_at"
  ],
  "properties": {
    "source_id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "stt_model": {
      "type": "string"
    },
    "language_detected": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-zA-Z]{2,3}(-[a-zA-Z0-9]{2,8})*$"
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0
    },
    "text": {
      "type": "string",
      "description": "Plain text, chunks joined in index order, skipped chunks omitted."
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
