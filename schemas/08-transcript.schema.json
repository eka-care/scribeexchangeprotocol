{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:scribe-exchange:schema:transcript",
  "$comment": "Defined in spec/08-transcripts.md §8.2–8.3 (Scribe Exchange Protocol v0.1)",
  "title": "Transcript",
  "description": "The text of one recording, as ordered segments. Grows while recording; complete when the audio source reaches success.",
  "type": "object",
  "required": [
    "id",
    "session_id",
    "source_id",
    "complete",
    "stt_model",
    "language_detected",
    "duration_ms",
    "segment_count",
    "text",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "session_id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "source_id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "complete": {
      "type": "boolean"
    },
    "stt_model": {
      "type": "string"
    },
    "language_detected": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-zA-Z]{2,3}(-[a-zA-Z0-9]{2,8})*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0
    },
    "segment_count": {
      "type": "integer",
      "minimum": 0
    },
    "text": {
      "type": "string",
      "description": "Plain-text rendering: one segment per line, speaker label prefixed when present."
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "segment": {
      "type": "object",
      "required": [
        "index",
        "text",
        "start_ms",
        "end_ms",
        "speaker",
        "language",
        "confidence",
        "chunk_index"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "text": {
          "type": "string"
        },
        "start_ms": {
          "type": "integer",
          "minimum": 0
        },
        "end_ms": {
          "type": "integer",
          "minimum": 0
        },
        "speaker": {
          "type": [
            "string",
            "null"
          ],
          "description": "Opaque label the model assigned (S1, S2, ...). null when the model separates no speakers."
        },
        "language": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-zA-Z]{2,3}(-[a-zA-Z0-9]{2,8})*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "confidence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "chunk_index": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
