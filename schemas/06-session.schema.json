{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:scribe-exchange:schema:session",
  "$comment": "Defined in spec/06-sessions.md §6.2 (Scribe Exchange Protocol v0.1)",
  "title": "Session",
  "description": "A folder of sources and the documents made from them. Has no outcome: it is active or archived.",
  "type": "object",
  "required": [
    "id",
    "status",
    "metadata",
    "created_at",
    "archived_at",
    "sources",
    "document_ids"
  ],
  "properties": {
    "id": {
      "$ref": "#/$defs/ulid"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "archived"
      ],
      "description": "Closed list. archived = read-only."
    },
    "metadata": {
      "type": "object",
      "description": "Client pass-through, returned unchanged. Max 4 KB. Never interpreted by the service."
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "archived_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "urn:scribe-exchange:schema:source"
      },
      "description": "Every source, in creation order. Omitted in list responses, which carry source_count instead."
    },
    "source_count": {
      "type": "integer",
      "minimum": 0,
      "description": "In list responses only."
    },
    "document_ids": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ulid"
      }
    }
  },
  "$defs": {
    "ulid": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    }
  }
}
