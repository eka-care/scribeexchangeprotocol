{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:scribe-exchange:schema:source",
  "$comment": "Defined in spec/06-sessions.md §6.4, §6.7 (Scribe Exchange Protocol v0.1)",
  "title": "Source",
  "description": "One thing put into a session: a recording (audio), a pasted note (text), a file, or a pointer to earlier work (reference). Only audio has a lifecycle. Immutable.",
  "type": "object",
  "required": [
    "id",
    "kind",
    "status",
    "created_at"
  ],
  "properties": {
    "id": {
      "$ref": "#/$defs/ulid"
    },
    "kind": {
      "type": "string",
      "description": "Open list. This version defines audio, text, file, reference. Clients ignore kinds they do not know."
    },
    "status": {
      "type": "string",
      "enum": [
        "ready",
        "failed",
        "created",
        "recording",
        "processing",
        "success",
        "cancelled"
      ],
      "description": "Closed list. ready | failed for non-audio kinds; created → recording → processing → success | failed | cancelled for audio."
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "text": {
      "type": "string",
      "description": "text kind: the text itself."
    },
    "file": {
      "type": "object",
      "required": [
        "name",
        "content_type",
        "size_bytes",
        "url"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "content_type": {
          "type": "string"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "url": {
          "type": "string",
          "format": "uri",
          "description": "Where the bytes can be fetched: an API path (bearer applies) or a short-lived signed storage URL."
        }
      },
      "description": "file kind. name, content_type, size_bytes and url, where url is where the bytes can be fetched."
    },
    "reference": {
      "type": "object",
      "properties": {
        "session_id": {
          "$ref": "#/$defs/ulid"
        },
        "document_id": {
          "$ref": "#/$defs/ulid"
        }
      },
      "oneOf": [
        {
          "required": [
            "session_id"
          ]
        },
        {
          "required": [
            "document_id"
          ]
        }
      ],
      "description": "reference kind: exactly one of session_id or document_id, that the caller may see."
    },
    "input": {
      "type": "string",
      "enum": [
        "chunked",
        "file"
      ],
      "description": "audio kind. Closed list in this version; stream reserved."
    },
    "language_hints": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/language"
      },
      "description": "audio kind. Empty = detect."
    },
    "stt_model": {
      "type": "string",
      "description": "audio kind. Id from models.stt."
    },
    "recording_started_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "recording_ended_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "completed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "chunks": {
      "type": "object",
      "required": [
        "received",
        "expected",
        "transcribed"
      ],
      "properties": {
        "received": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "description": "Indexes held, ascending."
        },
        "expected": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "description": "Total announced at end, or null."
        },
        "transcribed": {
          "type": "integer",
          "minimum": 0,
          "description": "How many chunks have a text or failed (chapter 8)."
        }
      },
      "description": "audio kind."
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "max_duration_reached",
              "auto_ended",
              "chunk_skipped",
              "chunks_missing"
            ]
          },
          "message": {
            "type": "string"
          },
          "chunk_index": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "description": "audio kind. Problems that did not stop the recording."
    },
    "failure": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "transcription_failed",
            "audio_unreadable",
            "language_unsupported",
            "internal_error",
            "fetch_failed"
          ]
        },
        "message": {
          "type": "string"
        }
      },
      "description": "Set when status is failed. fetch_failed is for a file given by URL."
    },
    "cancel_reason": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "client",
        "no_audio",
        null
      ],
      "description": "audio kind. Set when cancelled."
    },
    "transport": {
      "oneOf": [
        {
          "$ref": "#/$defs/transport"
        },
        {
          "type": "null"
        }
      ],
      "description": "audio kind. Where and how to send audio. Present while created or recording; null after."
    },
    "format": {
      "type": "string",
      "description": "audio kind. MIME type of the audio, one of discovery formats. Fixed at creation."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "audio"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "input",
          "language_hints",
          "stt_model",
          "recording_started_at",
          "recording_ended_at",
          "completed_at",
          "chunks",
          "warnings",
          "failure",
          "cancel_reason",
          "transport",
          "format"
        ],
        "properties": {
          "status": {
            "enum": [
              "created",
              "recording",
              "processing",
              "success",
              "failed",
              "cancelled"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "text"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "text"
        ],
        "properties": {
          "status": {
            "enum": [
              "ready",
              "failed"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "file"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "file"
        ],
        "properties": {
          "status": {
            "enum": [
              "ready",
              "failed",
              "processing"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "reference"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "reference"
        ],
        "properties": {
          "status": {
            "enum": [
              "ready",
              "failed"
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "ulid": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "language": {
      "type": "string",
      "pattern": "^[a-zA-Z]{2,3}(-[a-zA-Z0-9]{2,8})*$"
    },
    "transport": {
      "type": "object",
      "required": [
        "kind"
      ],
      "description": "Where and how to send audio. put: a URL under the service's API. post-form: a pre-signed form straight to an object store. The client uses it as given.",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "put",
            "post-form",
            "websocket"
          ]
        },
        "url": {
          "type": "string",
          "format": "uri",
          "description": "put (file) and post-form: the upload URL."
        },
        "url_template": {
          "type": "string",
          "description": "put (chunked): contains the literal {n} to replace with the chunk index."
        },
        "headers": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "put: request headers to send with every upload."
        },
        "fields": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "post-form: form fields to send before the file field."
        },
        "expires_at": {
          "type": "string",
          "format": "date-time",
          "description": "When the URL stops accepting uploads. Fetch the source for a fresh transport after this."
        }
      }
    }
  }
}
